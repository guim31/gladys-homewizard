        "es": "Apagar un enchufe HomeWizard"
      },
      "description": {
        "en": "Switch an Energy Socket off (refused while its switch lock is on).",
        "fr": "Éteint une Energy Socket (refusé tant que son verrouillage est actif).",
        "de": "Schaltet eine Energy Socket aus (abgelehnt, solange ihre Tastensperre aktiv ist).",
        "es": "Apaga un Energy Socket (rechazado mientras su bloqueo esté activo)."
      },
      "timeout_seconds": 15,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Energy Socket",
            "fr": "Prise Energy Socket",
            "de": "Energy Socket",
            "es": "Enchufe Energy Socket"
          },
          "required": true
