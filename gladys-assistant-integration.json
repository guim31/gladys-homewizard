  "scene_actions": [
    {
      "key": "turn_on_socket",
      "label": {
        "en": "Turn on a HomeWizard socket",
        "fr": "Allumer une prise HomeWizard",
        "de": "HomeWizard-Steckdose einschalten",
        "es": "Encender un enchufe HomeWizard"
      },
      "description": {
        "en": "Switch an Energy Socket on (refused while its switch lock is on).",
        "fr": "Allume une Energy Socket (refusé tant que son verrouillage est actif).",
        "de": "Schaltet eine Energy Socket ein (abgelehnt, solange ihre Tastensperre aktiv ist).",
        "es": "Enciende un Energy Socket (rechazado mientras su bloqueo esté activo)."
      },
      "timeout_seconds": 15,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Energy Socket",
            "fr": "Prise Energy Socket",
            "de": "Energy Socket",
            "es": "Enchufe Energy Socket"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "power_on",
          "type": "boolean",
          "label": {
            "en": "Socket on",
            "fr": "Prise allumée",
            "de": "Steckdose an",
            "es": "Enchufe encendido"
          }
        }
      ]
    },
