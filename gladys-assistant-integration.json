{
  "manifest_version": 1,
  "type": "device",
  "name": "HomeWizard Energy",
  "description": {
    "en": "HomeWizard P1 Meter, Energy Socket, kWh meters, Watermeter and battery, read on the local network.",
    "fr": "Compteur P1, prise, compteurs kWh, compteur d'eau et batterie HomeWizard, lus en réseau local.",
    "de": "HomeWizard P1 Meter, Energy Socket, kWh-Zähler, Wasserzähler und Akku, im lokalen Netz gelesen.",
    "es": "Medidor P1, enchufe, medidores kWh, contador de agua y batería HomeWizard, leídos en la red local."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-homewizard:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-homewizard/main/cover.png",
  "categories": ["energy"],
  "transports": ["local"],
  "network_discovery": [
    {
      "type": "mdns",
      "service": "_hwenergy._tcp"
    },
    {
      "type": "mdns",
      "service": "_homewizard._tcp"
    }
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Finding your HomeWizard devices",
        "fr": "Trouver vos appareils HomeWizard",
        "de": "Deine HomeWizard-Geräte finden",
        "es": "Encontrar sus dispositivos HomeWizard"
      },
      "description": {
        "en": "Turn on \"Local API\" for each device in the HomeWizard Energy app, then open the Discovery tab: devices on the same network as Gladys are found automatically. Newer devices (P1 Meter, kWh meters, battery) also offer the secure API v2: run Pair and press their button.",
        "fr": "Activez « API locale » pour chaque appareil dans l'application HomeWizard Energy, puis ouvrez l'onglet Découverte : les appareils du réseau de Gladys sont trouvés seuls. Les récents (P1, kWh, batterie) ont aussi l'API v2 sécurisée : lancez Jumeler et appuyez sur leur bouton.",
        "de": "Aktiviere „Lokale API“ für jedes Gerät in der HomeWizard-Energy-App und öffne den Tab „Entdecken“: Geräte im Netz von Gladys werden automatisch gefunden. Neuere Geräte (P1, kWh, Akku) bieten auch die sichere API v2: Starte Koppeln und drück ihre Taste.",
        "es": "Active «API local» para cada dispositivo en la aplicación HomeWizard Energy y abra la pestaña Descubrir: los dispositivos de la red de Gladys se encuentran solos. Los recientes (P1, kWh, batería) ofrecen la API v2 segura: inicie Vincular y pulse su botón."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-homewizard/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        }
      ]
    },
    {
      "key": "hosts",
      "type": "string",
      "label": {
        "en": "IP addresses of HomeWizard devices",
        "fr": "Adresses IP des appareils HomeWizard",
        "de": "IP-Adressen der HomeWizard-Geräte",
        "es": "Direcciones IP de los dispositivos HomeWizard"
      },
      "description": {
        "en": "Optional, separated by commas. Only needed for the devices automatic discovery does not find.",
        "fr": "Facultatif, séparées par des virgules. Seulement pour les appareils que la découverte automatique ne trouve pas.",
        "de": "Optional, durch Kommas getrennt. Nur für Geräte nötig, die die automatische Erkennung nicht findet.",
        "es": "Opcional, separadas por comas. Solo para los dispositivos que el descubrimiento automático no encuentra."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.40, 192.168.1.41",
        "fr": "ex. 192.168.1.40, 192.168.1.41",
        "de": "z. B. 192.168.1.40, 192.168.1.41",
        "es": "p. ej. 192.168.1.40, 192.168.1.41"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle d'actualisation",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often each device is read. Power values follow this pace; indexes, voltages and currents are sent to Gladys at most once a minute.",
        "fr": "Fréquence de lecture de chaque appareil. Les puissances suivent ce rythme ; index, tensions et courants sont envoyés à Gladys au plus une fois par minute.",
        "de": "Wie oft jedes Gerät gelesen wird. Leistungswerte folgen diesem Takt; Zählerstände, Spannungen und Ströme gehen höchstens einmal pro Minute an Gladys.",
        "es": "Frecuencia de lectura de cada dispositivo. Las potencias siguen este ritmo; los índices, tensiones y corrientes se envían a Gladys como máximo una vez por minuto."
      },
      "required": false,
      "default": "10",
      "options": [
        {
          "value": "2",
          "label": {
            "en": "2 seconds",
            "fr": "2 secondes",
            "de": "2 Sekunden",
            "es": "2 segundos"
          }
        },
        {
          "value": "5",
          "label": {
            "en": "5 seconds",
            "fr": "5 secondes",
            "de": "5 Sekunden",
            "es": "5 segundos"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "10 seconds",
            "fr": "10 secondes",
            "de": "10 Sekunden",
            "es": "10 segundos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de las funciones"
      },
      "description": {
        "en": "Used for the names of new devices' features and for the messages of scene actions.",
        "fr": "Utilisée pour les noms des fonctionnalités des nouveaux appareils et pour les messages des actions de scène.",
        "de": "Wird für die Funktionsnamen neuer Geräte und für die Meldungen der Szenenaktionen verwendet.",
        "es": "Se usa para los nombres de las funciones de los nuevos dispositivos y para los mensajes de las acciones de escena."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "search",
      "label": {
        "en": "Search for HomeWizard devices",
        "fr": "Rechercher les appareils HomeWizard",
        "de": "Nach HomeWizard-Geräten suchen",
        "es": "Buscar dispositivos HomeWizard"
      },
      "timeout_seconds": 60
    },
    {
      "key": "pair",
      "label": {
        "en": "Pair (API v2): press the device button",
        "fr": "Jumeler (API v2) : appuyez sur le bouton",
        "de": "Koppeln (API v2): Gerätetaste drücken",
        "es": "Vincular (API v2): pulse el botón"
      },
      "timeout_seconds": 90
    },
    {
      "key": "identify",
      "label": {
        "en": "Blink a device's light",
        "fr": "Faire clignoter un appareil",
        "de": "Geräteleuchte blinken lassen",
        "es": "Hacer parpadear un dispositivo"
      },
      "timeout_seconds": 15,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Device",
            "fr": "Appareil",
            "de": "Gerät",
            "es": "Dispositivo"
          },
          "required": true
        }
      ]
    }
  ],
